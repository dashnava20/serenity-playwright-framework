{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": ["node", "@playwright/test"],
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "specs/**/*.ts",
    "playwright.config.ts",
    "serenity.conf.ts"
  ]
}
